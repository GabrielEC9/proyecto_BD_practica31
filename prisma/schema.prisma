generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cliente {
  id_cliente     Int        @id @default(autoincrement())
  nombre         String     @db.VarChar(50)
  telefono       String?    @db.VarChar(15)
  direccion      String?
  apellido       String?    @db.VarChar(50)
  correo         String?    @db.VarChar(100)
  fecha_registro DateTime?  @default(now()) @db.Timestamp(6)
  estado         String?    @default("ACTIVO") @db.VarChar(10)
  vehiculo       vehiculo[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orden_no_prioritaria {
  id_orden        Int           @id
  tiempo_estimado Int?
  descuento       Decimal?      @db.Decimal(10, 2)
  orden_trabajo   orden_trabajo @relation(fields: [id_orden], references: [id_orden], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orden_prioritaria {
  id_orden      Int           @id
  fecha_limite  DateTime?     @db.Date
  recargo       Decimal?      @db.Decimal(10, 2)
  orden_trabajo orden_trabajo @relation(fields: [id_orden], references: [id_orden], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orden_trabajo {
  id_orden             Int                   @id @default(autoincrement())
  fecha_ingreso        DateTime?             @db.Date
  fecha_salida         DateTime?             @db.Date
  estado_pago          String?               @db.VarChar(20)
  id_vehiculo          Int?
  id_servicio          Int?
  total                Decimal?              @db.Decimal(10, 2)
  pagado               Boolean?              @default(false)
  estado               String?               @default("PENDIENTE") @db.VarChar(20)
  orden_no_prioritaria orden_no_prioritaria?
  orden_prioritaria    orden_prioritaria?
  servicio             servicio?             @relation(fields: [id_servicio], references: [id_servicio], onDelete: NoAction, onUpdate: NoAction)
  vehiculo             vehiculo?             @relation(fields: [id_vehiculo], references: [id_vehiculo], onDelete: NoAction, onUpdate: NoAction)
}

model servicio {
  id_servicio       Int             @id @default(autoincrement())
  descripcion       String?
  costo             Decimal?        @db.Decimal(10, 2)
  nombre_servicio   String?         @db.VarChar(100)
  duracion_estimado Int?
  orden_trabajo     orden_trabajo[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vehiculo {
  id_vehiculo    Int             @id @default(autoincrement())
  marca          String?         @db.VarChar(50)
  modelo         String?         @db.VarChar(50)
  anio           Int?
  matricula      String?         @db.VarChar(20)
  id_cliente     Int?
  tipo           String?         @db.VarChar(20)
  fecha_registro DateTime?       @default(now()) @db.Timestamp(6)
  orden_trabajo  orden_trabajo[]
  cliente        cliente?        @relation(fields: [id_cliente], references: [id_cliente], onDelete: NoAction, onUpdate: NoAction)
}

model UsuarioORM {
  id        Int      @id @default(autoincrement())
  usuario   String   @unique
  password  String
  createdAt DateTime @default(now())
}
